{
  "name": "framekit-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @framekit/docs",
    "build": "npm run build -w @presentstandards/framekit-ui && npm run build -w @framekit/docs",
    "build:kit": "npm run build -w @presentstandards/framekit-ui",
    "build:docs": "npm run build -w @framekit/docs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\""
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  }
}
